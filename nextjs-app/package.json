{
  "name": "baunthiyal-path-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-bpl \"node --conditions=react-server --import tsx --test --test-concurrency=1 tests/*.integration.ts\"",
    "format": "prettier --write app components lib tests scripts next.config.ts *.json *.md",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "setup:verify": "node scripts/check-setup.mjs --live",
    "setup:scheduler": "node scripts/setup-scheduler.mjs",
    "setup:firebase": "node scripts/connect-firebase.mjs",
    "postinstall": "node scripts/patch-signal-logs.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "exceljs": "^4.4.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.4",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.35.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@grpc/grpc-js": "^1.14.7"
  }
}
