# Never commit actual credentials. Configure in deployment environment settings.
APP_URL=http://localhost:3000
FIREBASE_USE_ADC=false
# Firebase project number is NOT the string Project ID used by Auth/Firestore.
FIREBASE_PROJECT_NUMBER=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 32 random bytes encoded as 64 hex characters. Server-only, stable across deployments.
# Encrypts per-account WhatsApp tokens saved from the integration page.
WHATSAPP_CONNECTION_ENCRYPTION_KEY=
# Pin a currently supported Graph API version after checking your Meta app.
WHATSAPP_GRAPH_VERSION=v23.0
LAB_PHONE=
# Required: estimated India marketing rate in paise, NOT a claimed Meta invoice.
WHATSAPP_MARKETING_RATE_PAISE=
# Set to the Meta account's real available sending allowance. Default 1,000.
WHATSAPP_DAILY_LIMIT=1000
WHATSAPP_BATCH_SIZE=20
# Generate random values, minimum 32 characters; these are server-only.
CRON_SECRET=
PUBLIC_RATE_LIMIT_SECRET=
# Optional existing portal base URL for sidebar navigation.
NEXT_PUBLIC_EXISTING_PORTAL_URL=

# Optional Google Cloud Scheduler OIDC authentication (preferred for production).
SCHEDULER_REGION=
SCHEDULER_SERVICE_ACCOUNT=
# Exact deployed worker URL, e.g. https://your-domain/api/worker
WORKER_OIDC_AUDIENCE=

# Only needed if the project contains multiple existing Firebase web apps.
FIREBASE_WEB_APP_ID=

# Inbox server identity: use a dedicated datastore-only service account.
# Configure JSON as a hosted secret; a local file is an alternative for Node development.
WHATSAPP_SERVICE_ACCOUNT_JSON=
WHATSAPP_SERVICE_ACCOUNT_FILE=
WHATSAPP_WEBHOOK_BASE_URL=
# Keep false until the callback is explicitly made public and subscribed in Meta.
WHATSAPP_WEBHOOK_PUBLIC_READY=false
